    given-names: Randy
    email: erwinrandy3@gmail.com
version: "0.0.1"
date-released: "2026-07-23"
license: Apache-2.0
repository-code: "https://github.com/rvndye/synthaudit-bench"
url: "https://github.com/rvndye/synthaudit-bench"
keywords:
  - synthetic data
  - benchmark
  - data auditing
  - benchmark validity
  - trustworthiness
  - tabular data
